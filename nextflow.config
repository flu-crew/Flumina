/*
 * Flumina — Nextflow configuration
 *
 * Replaces the Snakemake-era config.cfg + driver script. The mapping is:
 *
 *   config.cfg              ->  here
 *   ----------------------      --------------------------------------------
 *   OUTPUT_DIRECTORY        ->  params.outdir
 *   READ_DIRECTORY          ->  params.read_directory
 *   THREADS                 ->  -profile / process.cpus (Nextflow schedules)
 *   CLUSTER_JOBS            ->  -profile slurm          (executor config)
 *   FORCE_UNLOCK            ->  gone; Nextflow has no lock files
 *   TEMPDIR                 ->  workDir
 *   OVERWRITE               ->  gone; use -resume to reuse, or a fresh outdir
 *
 * Everything else keeps its name in lower_snake_case. The R scripts still read a
 * KEY=VALUE config.cfg, so the pipeline writes one from these params at runtime
 * (see WRITE_CONFIG in main.nf) — the R scripts are used unmodified.
 */

params {
    // ---- inputs -----------------------------------------------------------
    read_directory          = null          // dir of raw paired fastq.gz
    rename_file             = null          // CSV: File,Sample
    reference               = null          // reference fasta
    aa_db                   = null          // curated AA database CSV
    metadata                = null          // metadata CSV with a Sample column
    outdir                  = 'results'

    // ---- behaviour --------------------------------------------------------
    run_irma                = true          // was DISABLE_IRMA (inverted)
    snpgenie                = false
    wfabc                   = false

    // ---- variant filtering ------------------------------------------------
    // Keep min_depth >= 100. Below that, LoFreq/GATK report false fixations from
    // low template input (founder/jackpot effect) — the artefact that makes
    // replicate libraries look like fixed differences.
    min_depth               = 100
    min_quality             = 30
    min_allele_frequency    = 0.01
    dedup_keys              = ''            // e.g. 'Animal.ID,DPI,Quarter'
    // Name of a COLUMN in the METADATA csv to group summaries by (e.g. host type).
    // findAAChanges.R merges METADATA into the amino-acid table, so any of its
    // columns can be used here. Set to 'NULL' for no grouping.
    group_names             = 'discrete_host'

    // ---- WFABC ------------------------------------------------------------
    individual_column       = 'Animal_ID'
    time_column             = 'DPI'
    generations_per_time    = 1
    fixation_cutoff         = 0.98
    wfabc_timeout           = 120
    max_refine_iter         = 10

    // ---- misc -------------------------------------------------------------
    publish_mode            = 'copy'
    help                    = false
}

// Nextflow writes every task into its own work dir, so processes never collide
// and -resume works at task granularity rather than Snakemake's file timestamps.
// Left at the default ./work — deriving it from params.outdir does not work,
// because workDir is resolved before -profile is applied.
// Override per-run with `-w /scratch/$USER/flumina` on a cluster.

process {
    errorStrategy = { task.exitStatus in [104,134,137,138,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low    { cpus = 1; memory = 4.GB;  time = 2.h  }
    withLabel: process_medium { cpus = 4; memory = 12.GB; time = 8.h  }
    withLabel: process_high   { cpus = 8; memory = 32.GB; time = 24.h }

    // GATK tools are single-threaded and JVM-heavy; give them headroom but not cores.
    withLabel: gatk           { cpus = 2; memory = 12.GB; time = 12.h }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled       = true
        // --platform is explicit: the image is amd64-only (bioconda has no
        // aarch64 builds for gatk4/irma/lofreq), so on Apple Silicon this runs
        // under emulation rather than failing with an exec format error.
        docker.runOptions    = '-u $(id -u):$(id -g) --platform linux/amd64'
        process.container    = 'flumina:latest'
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = 'flumina.sif'
    }

    slurm {
        process.executor     = 'slurm'
        process.queue        = 'priority'
        process.clusterOptions = '--qos=vpru -A nadc_iav'
    }

    // Runs the bundled 4-sample test_dataset. Used by CI.
    test {
        params.read_directory = "${projectDir}/test_dataset/raw_reads"
        params.rename_file    = "${projectDir}/example_file_rename.csv"
        params.reference      = "${projectDir}/reference.fa"
        params.aa_db          = "${projectDir}/curated_database.csv"
        params.metadata       = "${projectDir}/example_metadata.csv"
        params.outdir         = 'test_results'
        params.run_irma       = false      // IRMA is slow; exercised separately
        params.group_names    = 'discrete_host'   // exercises the grouping path
    }
}

// Provenance: these four files are what let you answer "how was this produced?"
// six months later, which is exactly what an accredited lab has to answer.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html";  overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";    overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";      overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";       overwrite = true }

manifest {
    name            = 'flu-crew/Flumina'
    description     = 'Variant calling pipeline for influenza A Illumina sequence data'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0-dev'
}
