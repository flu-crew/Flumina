/*
 * Flumina — Nextflow configuration
 *
 * Replaces the Snakemake-era config.cfg + driver script. The mapping is:
 *
 *   config.cfg              ->  here
 *   ----------------------      --------------------------------------------
 *   OUTPUT_DIRECTORY        ->  params.outdir
 *   READ_DIRECTORY          ->  params.read_directory
 *   THREADS                 ->  -profile / process.cpus (Nextflow schedules)
 *   CLUSTER_JOBS            ->  -profile slurm          (executor config)
 *   FORCE_UNLOCK            ->  gone; Nextflow has no lock files
 *   TEMPDIR                 ->  workDir
 *   OVERWRITE               ->  gone; use -resume to reuse, or a fresh outdir
 *
 * Everything else keeps its name in lower_snake_case. The R scripts still read a
 * KEY=VALUE config.cfg, so the pipeline writes one from these params at runtime
 * (see WRITE_CONFIG in main.nf) — the R scripts are used unmodified.
 */

params {
    // ---- inputs -----------------------------------------------------------
    read_directory          = null          // dir of raw paired fastq.gz
    rename_file             = null          // CSV: File,Sample
    reference               = null          // reference fasta
    aa_db                   = null          // curated AA database CSV
    metadata                = null          // metadata CSV with a Sample column
    outdir                  = 'results'
    // Optional IRMA parameter file (TMP, SINGLE_LOCAL_PROC, ...). Staged into
    // each IRMA task as ./irma_config.sh, which IRMA sources on its own.
    irma_config             = null

    // ---- resources --------------------------------------------------------
    // Upper bound on CPUs Flumina may use at once. The local executor is capped
    // at this, and no single process may request more than it, so `-t 2` on a
    // laptop does not deadlock waiting for cores that will never be free.
    max_cpus                = 4
    // Ceiling on memory any one process may request. The defaults below are
    // sized for a cluster node; without a ceiling a laptop or a memory-limited
    // Docker Desktop VM fails immediately with "process requirement exceeds
    // available memory" rather than simply running slower. The slurm profile
    // raises both of these, so cluster runs still get the full allocation.
    max_memory              = '6.GB'

    // ---- behaviour --------------------------------------------------------
    run_irma                = true          // was DISABLE_IRMA (inverted)
    snpgenie                = false
    wfabc                   = false
    // Screen IRMA consensus for H5N1 markers of interest (FluMutDB). Requires
    // run_irma=true — there is no consensus to screen otherwise. The marker
    // database version is whatever flumut=0.6.5 (environment.yaml) bundles;
    // see the FLUMUT process comment in main.nf for why it is never
    // auto-updated at run time.
    flumut                  = true
    // Also screen low-frequency variants (default: off). When enabled, applies
    // LoFreq variants above flumut_freq_threshold to IRMA consensus sequences,
    // creating mutated pseudo-consensus for FluMut marker screening.
    flumut_lowfreq          = false
    // Minimum allele frequency (0–1) for variants included in low-freq FluMut
    // screening. Default 0.01 = 1% (standard heteroplasmy threshold).
    flumut_freq_threshold   = 0.01
    // Screen the reference itself and subtract its own FluMut findings from the
    // sample results. On by default because the alternative is unusable: the
    // reference carries markers of its own, every sample inherits them, and on
    // the swine WGS run 2,514 of 2,515 reported marker rows across 30 samples
    // were identical to the reference. Set false to see the raw output — which
    // is written as *_all.tsv either way, alongside reference_*.tsv.
    flumut_subtract_reference = true

    // FluMut is an H5N1 tool, and its HA/NA markers are numbered for H5/N1
    // specifically — the protein names say so: HA1-5, NA-1. Off-subtype, two
    // things go wrong at once. H3 and H5 HA1 differ in length and alignment, so
    // position 139 in one is not position 139 in the other; and the two have
    // diverged far enough that even a correctly mapped residue need not carry
    // the same meaning.
    //
    // The internal genes are fine. PB2, PB1, PA, NP and NS markers are
    // subtype-agnostic biology — PB2:K702R raises polymerase activity in
    // mammalian cells whatever the HA is — and on the swine H3N2 run that was 50
    // of the 69 retained markers. So the tool stays useful off-subtype; only
    // HA/NA are suspect.
    //
    // false (default) drops HA/NA marker rows when the reference's subtype does
    // not match the database's H5/N1. Subtype is read from the reference segment
    // names (A_HA_H3, A_NA_N2); a bare A_HA cannot be confirmed and counts as a
    // mismatch, not as a pass. Nothing is destroyed — the dropped rows stay in
    // markers_all.tsv.
    //
    // NOTE: filter on the protein prefix, never the Subtype column. Subtype
    // records which virus a finding was PUBLISHED in, not which numbering the
    // position uses: PB2:K702R is labelled H5N1 and is perfectly valid on swine.
    flumut_keep_mismatched_ha_na = false

    // ---- variant filtering ------------------------------------------------
    // Keep min_depth >= 100. Below that, LoFreq/GATK report false fixations from
    // low template input (founder/jackpot effect) — the artefact that makes
    // replicate libraries look like fixed differences.
    min_depth               = 100
    min_quality             = 30
    min_allele_frequency    = 0.01
    dedup_keys              = ''            // e.g. 'Animal.ID,DPI,Quarter'
    // Name of a COLUMN in the METADATA csv to group summaries by (e.g. host type).
    // findAAChanges.R merges METADATA into the amino-acid table, so any of its
    // columns can be used here. Set to 'NULL' for no grouping.
    group_names             = 'discrete_host'

    // ---- WFABC ------------------------------------------------------------
    individual_column       = 'Animal_ID'
    time_column             = 'DPI'
    generations_per_time    = 1
    fixation_cutoff         = 0.98
    wfabc_timeout           = 120
    max_refine_iter         = 10

    // ---- cluster ----------------------------------------------------------
    // Settings for the scheduler profiles (slurm, pbs, pbspro, sge, lsf). These
    // MUST be changed to match your cluster — the defaults are the flu-crew
    // Slurm queue and will be rejected outright anywhere else. The contents are
    // passed through to the scheduler untouched, so use whatever syntax it
    // expects: '--qos=x -A acct' for Slurm, '-A acct' for PBS, and so on.
    cluster_queue           = 'priority'
    cluster_options         = '--qos=vpru -A nadc_iav'
    // Maximum scheduler jobs in flight at once. This is the main throughput dial
    // for a large run.
    queue_size              = 100
    // Where Apptainer keeps the image it converts from the Docker one. Left
    // null on purpose: Nextflow's own default is NXF_APPTAINER_CACHEDIR if set,
    // otherwise a directory under the work dir — which is already on fast,
    // node-visible storage precisely because the work dir has to be. That is
    // the right place for a multi-GB .sif, and it means nobody has to set an
    // environment variable to avoid filling a quota'd home directory.
    // Set this only to share one converted image across separate runs.
    apptainer_cache         = null

    // ---- misc -------------------------------------------------------------
    // Container image used by the docker and apptainer profiles.
    container               = 'chutter/flumina:latest'
    publish_mode            = 'copy'
    help                    = false
}

// Nextflow writes every task into its own work dir, so processes never collide
// and -resume works at task granularity rather than Snakemake's file timestamps.
// Left at the default ./work — deriving it from params.outdir does not work,
// because workDir is resolved before -profile is applied.
// Override per-run with `-w /scratch/$USER/flumina` on a cluster.

// A process asking for more cpus or memory than the run is allowed to use would
// never be schedulable, so every label is capped at params.max_cpus and
// params.max_memory (set by `flumina -t` and `flumina -M`).
//
// The caps are written inline as closures rather than as shared helper
// functions. Nextflow's config parser became strict in 25.x and no longer
// accepts `def` function definitions in a config file — it fails the whole run
// with "Unexpected input: '('" before anything starts. Closures assigned to a
// directive remain valid, and are evaluated lazily when the task is created.
process {
    errorStrategy = { task.exitStatus in [104,134,137,138,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { Math.max(1, Math.min(1, params.max_cpus as int)) }
        memory = { 4.GB.compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0
                     ? params.max_memory as nextflow.util.MemoryUnit : 4.GB }
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = { Math.max(1, Math.min(4, params.max_cpus as int)) }
        memory = { 12.GB.compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0
                     ? params.max_memory as nextflow.util.MemoryUnit : 12.GB }
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = { Math.max(1, Math.min(8, params.max_cpus as int)) }
        memory = { 32.GB.compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0
                     ? params.max_memory as nextflow.util.MemoryUnit : 32.GB }
        time   = 24.h
    }
    // GATK tools are single-threaded and JVM-heavy; give them headroom but not cores.
    withLabel: gatk {
        cpus   = { Math.max(1, Math.min(2, params.max_cpus as int)) }
        memory = { 12.GB.compareTo(params.max_memory as nextflow.util.MemoryUnit) > 0
                     ? params.max_memory as nextflow.util.MemoryUnit : 12.GB }
        time   = 12.h
    }
}

// Bounding total concurrent CPU use on the local executor used to be done here
// with an `executor.$local` block. That per-executor selector syntax is no
// longer recognised (25.x+ reports it as an unknown option and ignores it), so
// the limit is set inside the `standard` profile instead, where it is
// unambiguously the local executor being configured.

profiles {
    standard {
        process.executor = 'local'
        // Total cores the local executor may use at once. Without it, Nextflow
        // helps itself to every core on the machine regardless of -t.
        executor.cpus    = params.max_cpus
    }

    // Both container profiles name the published Docker Hub image, so a user who
    // followed the README's `docker pull chutter/flumina` already has exactly
    // what these resolve to. Override with --container to use a local build,
    // e.g. the `flumina:latest` produced by `docker build -t flumina:latest .`
    docker {
        docker.enabled       = true
        // --platform is explicit: the image is amd64-only (bioconda has no
        // aarch64 builds for gatk4/irma/lofreq), so on Apple Silicon this runs
        // under emulation rather than failing with an exec format error.
        docker.runOptions    = '-u $(id -u):$(id -g) --platform linux/amd64'
        process.container    = params.container
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // docker:// lets Apptainer pull and convert the same image itself, so
        // there is no separate .sif to build or keep in step with the Dockerfile.
        process.container    = "docker://${params.container}"
        // Nextflow's own cache location is deliberately left alone: its default
        // converts the image once, under the work directory, which every
        // compute node can already see. Overriding it here would replace a good
        // default with a guess about the user's filesystem.
        //
        // A user who wants a shared cache sets APPTAINER_CACHE in config.cfg,
        // and the launcher writes it into the generated -c file. It cannot be
        // done conditionally here: the config parser rejects `if` statements
        // mixed with config statements from 25.x onward.
    }

    // Scheduler profiles. Each submits every task as its own job, so independent
    // samples and independent steps run at the same time across the cluster.
    // This is where Flumina's speed comes from: with 100 samples the per-sample
    // chain runs ~100-wide rather than one after another.
    //
    // Nextflow must be running on the HOST for any of these, because it shells
    // out to the scheduler's own commands (sbatch/qsub/...). Combine with the
    // apptainer profile so each submitted job still executes inside the
    // container: `-p slurm,apptainer`, `-p pbs,apptainer`, and so on.
    //
    // They differ ONLY in the executor name; everything else — queue, account
    // options, job ceiling, resource lift — is shared and set the same way, so
    // the flumina flags -Q/-A/-j mean the same thing whichever scheduler you
    // are on. Nextflow supports more executors than are listed here (moab, oar,
    // condor, k8s, awsbatch ...); adding one is a copy of the block below with
    // a different executor name.
    slurm {
        process.executor = 'slurm'
        includeConfig 'conf/cluster.config'
    }

    // Torque / OpenPBS
    pbs {
        process.executor = 'pbs'
        includeConfig 'conf/cluster.config'
    }

    // PBS Pro (Altair). Distinct from `pbs`: Nextflow generates different
    // resource directives for it, so picking the wrong one gets jobs rejected.
    pbspro {
        process.executor = 'pbspro'
        includeConfig 'conf/cluster.config'
    }

    // Sun/Son of Grid Engine, still common on older clusters
    sge {
        process.executor = 'sge'
        includeConfig 'conf/cluster.config'
    }

    // IBM Spectrum LSF
    lsf {
        process.executor = 'lsf'
        includeConfig 'conf/cluster.config'
    }

    // Runs the bundled 4-sample test_dataset. Used by CI.
    test {
        params.read_directory = "${projectDir}/test_dataset/raw_reads"
        params.rename_file    = "${projectDir}/example_file_rename.csv"
        params.reference      = "${projectDir}/reference.fa"
        params.aa_db          = "${projectDir}/curated_database.csv"
        params.metadata       = "${projectDir}/example_metadata.csv"
        params.outdir         = 'test_results'
        params.run_irma       = false      // IRMA is slow; exercised separately
        params.group_names    = 'discrete_host'   // exercises the grouping path
    }
}

// Provenance: these four files are what let you answer "how was this produced?"
// six months later, which is exactly what an accredited lab has to answer.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html";  overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";    overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";      overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";       overwrite = true }

manifest {
    name            = 'flu-crew/Flumina'
    description     = 'Variant calling pipeline for influenza A Illumina sequence data'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}
