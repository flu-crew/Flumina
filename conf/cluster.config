/*
 * Settings shared by every scheduler profile (slurm, pbs, pbspro, sge, lsf).
 *
 * Keep these settings in one file so profiles differ only in executor name and
 * resource changes apply consistently to all schedulers.
 *
 * Nothing here is scheduler-specific. Queue and account options are passed
 * through to whatever the scheduler expects, so the syntax inside them
 * (`--qos=... -A acct` for Slurm, `-A acct -l ...` for PBS) is the user's to
 * get right for their site.
 */

process {
    queue          = params.cluster_queue
    clusterOptions = params.cluster_options
}

// Cluster nodes generally have more resources than a laptop or Docker Desktop
// VM, so restore the limits requested by the process labels.
params.max_cpus   = 8
params.max_memory = '32.GB'

executor {
    // Maximum number of queued or running jobs. Increase it when the scheduler
    // allocation permits; decrease it on a shared queue.
    queueSize       = params.queue_size
    // Rate-limit submissions to avoid bursts of sbatch/qsub calls that some
    // schedulers rate-limit or drop.
    submitRateLimit = '20/1min'
}
