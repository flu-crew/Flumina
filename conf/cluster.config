/*
 * Settings shared by every scheduler profile (slurm, pbs, pbspro, sge, lsf).
 *
 * Kept in one file so the profiles differ only in the executor name, and so a
 * change to the job ceiling or the resource lift cannot be applied to one
 * scheduler and forgotten on the others.
 *
 * Nothing here is scheduler-specific: queue and account options are passed
 * through to whatever the scheduler expects, so the syntax inside them
 * (`--qos=... -A acct` for Slurm, `-A acct -l ...` for PBS) is the user's to
 * get right for their site.
 */

process {
    queue          = params.cluster_queue
    clusterOptions = params.cluster_options
}

// A cluster node is not memory-starved the way a laptop or a Docker Desktop VM
// is, so lift the local-safe ceilings back to the values the process labels
// actually ask for.
params.max_cpus   = 8
params.max_memory = '32.GB'

executor {
    // How many jobs may be queued or running at once. Raise it to go wider if
    // your scheduler and allocation allow; lower it if you are asked to be a
    // better neighbour on a shared queue.
    queueSize       = params.queue_size
    // Drip-feed submissions instead of firing hundreds of sbatch/qsub calls in
    // one burst, which some schedulers rate-limit or simply drop.
    submitRateLimit = '20/1min'
}
