/*
 * Inputs for the bundled 4-sample test_dataset.
 *
 * Shared by the `test` and `test_full` profiles so the two cannot drift apart.
 * They differ only in whether IRMA — and therefore the FluMut marker path —
 * actually runs; see the profile comments in nextflow.config.
 */

params {
    read_directory = "${projectDir}/test_dataset/raw_reads"
    rename_file    = "${projectDir}/example_file_rename.csv"
    reference      = "${projectDir}/reference.fa"
    aa_db          = "${projectDir}/curated_database.csv"
    metadata       = "${projectDir}/example_metadata.csv"
    group_names    = 'discrete_host'   // exercises the grouping path
}
