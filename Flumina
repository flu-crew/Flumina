#!/bin/bash

date

# Check if a configuration file was provided
if [ -z "$1" ]; then
  echo "Usage: $0 path_to_config_file needed."
  exit 1
fi

CONFIG_FILE="$1"

# Check if the configuration file exists
if [ ! -f "$CONFIG_FILE" ]; then
  echo "Error: Configuration file not found at $CONFIG_FILE"
  exit 1
fi

# Source the configuration file
source "$CONFIG_FILE"

echo "Configuration file successfully loaded"

# Add Flumina conda env to PATH if snakemake not already available
if ! command -v snakemake &>/dev/null && [ -f "/Users/chutter/Bioinformatics/conda/Flumina/bin/snakemake" ]; then
  export PATH="/Users/chutter/Bioinformatics/conda/Flumina/bin:$PATH"
fi

# Add snpgenie conda env to PATH when SNPGENIE is enabled
if [ "${SNPGENIE:-FALSE}" = "TRUE" ] && [ -f "/Users/chutter/Bioinformatics/conda/snpgenie/bin/snpgenie.pl" ]; then
  export PATH="/Users/chutter/Bioinformatics/conda/snpgenie/bin:$PATH"
fi

# Use conda env Java if system Java is too old for GATK (need Java 17+)
CONDA_JAVA="/Users/chutter/Bioinformatics/conda/Flumina/lib/jvm/bin/java"
if [ -f "$CONDA_JAVA" ]; then
  JAVA_VER=$("$CONDA_JAVA" -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d. -f1)
  SYS_VER=$(java -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d. -f1)
  if [ "${SYS_VER:-0}" -lt 17 ] && [ "${JAVA_VER:-0}" -ge 17 ]; then
    export PATH="/Users/chutter/Bioinformatics/conda/Flumina/lib/jvm/bin:$PATH"
    export JAVA_HOME="/Users/chutter/Bioinformatics/conda/Flumina/lib/jvm"
  fi
fi

mkdir "$OUTPUT_DIRECTORY"

echo "Beginning read organization ... "

Rscript Scripts/organizeReads.R "$CONFIG_FILE"

echo "Beginning reference creation ... "

#Sets custom snakemake parameters
if [ "$FORCE_UNLOCK" = "TRUE" ]; then
    NOLOCK="--nolock"
else
    NOLOCK=""
fi

if [ "$CLUSTER_JOBS" != "FALSE" ]; then
    CLUSTER="--cluster \"$CLUSTER_JOBS\""
else
    CLUSTER=""
fi

#Sets the snakefile to use when disabling IRMA
if [ "$DISABLE_IRMA" == "TRUE" ]; then
    IRMA_RUN="Scripts/snakefile_process_SNPs.smk"
else
    IRMA_RUN="Scripts/snakefile_process_IRMA_SNPs.smk"
fi

#Copies reference to output directory so snakefile can find it
cp "$REFERENCE_FILE" "$OUTPUT_DIRECTORY"/reference.fa

#Export variable to global env
export CLUSTER_JOBS
export TEMPDIR

#Runs make the reference snakemake function
snakemake --snakefile Scripts/snakefile_make-reference.smk --directory "$OUTPUT_DIRECTORY" -j $THREADS $NOLOCK

#Runs SNV calling pipeline

echo "Beginning SNV calling pipeline ... "

if [ "$CLUSTER_JOBS" != "FALSE" ]; then
    snakemake --snakefile $IRMA_RUN --directory "$OUTPUT_DIRECTORY" -j $THREADS $NOLOCK --cluster "$CLUSTER_JOBS"
else
    snakemake --snakefile $IRMA_RUN --directory "$OUTPUT_DIRECTORY" -j $THREADS $NOLOCK
fi

#Organizes IRMA only when not disabled
if [ "$DISABLE_IRMA" == "FALSE" ]; then
    Rscript Scripts/organizeIRMA.R "$CONFIG_FILE"
fi

Rscript Scripts/convertVCFtoTable.R "$CONFIG_FILE"

Rscript Scripts/findAAChanges.R "$CONFIG_FILE"

Rscript Scripts/outputSummary.R "$CONFIG_FILE"

# Run SNPGenie dN/dS analysis if enabled
if [ "${SNPGENIE:-FALSE}" = "TRUE" ]; then
    echo "Beginning SNPGenie dN/dS analysis ... "
    Rscript Scripts/makeGTF.R   "$CONFIG_FILE"
    Rscript Scripts/runSNPGenie.R "$CONFIG_FILE"
fi

date
# End of file
